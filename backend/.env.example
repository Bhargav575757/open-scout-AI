# Application Configuration
APP_NAME=OpenScout API
APP_VERSION=0.6.0
DEBUG=False
PORT=8000
LOG_LEVEL=INFO

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=

# GitHub REST API Configuration (Optional Token)
GITHUB_TOKEN=

# Mistral AI Configuration (Phase 5)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Database Configuration (Phase 6 - PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/openscout

# Embedding & RAG Configuration (Phase 6)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
